{
  "name": "gadget-hub-coursework",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "node --watch --import tsx server/index.ts",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "npm run typecheck && tsc -p tsconfig.server.json && vite build",
    "start": "node scripts/dev.mjs --production",
    "test": "node --import tsx --test tests/*.test.mjs"
  },
  "dependencies": {
    "express": "5.3.0",
    "vue": "3.5.44",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "tsx": "4.23.15",
    "vite": "7.3.7",
    "vue-tsc": "3.3.13"
  }
}
